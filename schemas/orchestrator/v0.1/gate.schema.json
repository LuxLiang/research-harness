{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/orchestrator/v0.1/gate.schema.json",
  "title": "Research Orchestrator gate result v0.1",
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["id", "kind", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^(proj|rq|plan|lit|claim|exp|review|decision|proposal)-[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["Project", "ResearchQuestion", "ResearchPlan", "LiteratureEvidence", "ScientificClaim", "Experiment", "Review", "Decision", "ResearchProposal"]},
        "revision": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["gate_id", "gate_type", "verdict", "based_on", "target_refs", "target_output_ids", "review_refs", "rationale", "recorded_at"],
  "properties": {
    "gate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "gate_type": {"enum": ["FEASIBILITY", "PLAN", "TRACK", "COMPLETION", "CONSISTENCY", "WRITING", "FINAL", "PROPOSAL_REVIEW"]},
    "verdict": {"enum": ["PASS", "COMPLETE", "INCOMPLETE", "RETHINK_CLAIM", "RETHINK_PLAN", "RETHINK_QUESTION", "REVISION_REQUIRED", "AUTO_REVISION"]},
    "based_on": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
    "target_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "target_output_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "review_refs": {
      "type": "array",
      "items": {"allOf": [{"$ref": "#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "Review"}}}]}
    },
    "rationale": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
