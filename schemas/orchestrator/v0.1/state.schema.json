{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/orchestrator/v0.1/state.schema.json",
  "title": "Research Orchestrator checkpoint v0.1",
  "$defs": {
    "state": {
      "enum": [
        "DISCOVERY_QUESTION", "DISCOVERY_LITERATURE", "DISCOVERY_FEASIBILITY_GATE",
        "PLANNING_DRAFT", "PLANNING_APPROVAL", "PLANNING_ROUTING",
        "EXECUTION_MATERIALIZE", "EXECUTION_TRACKS", "EXECUTION_JOIN",
        "SYNTHESIS_BUILD", "SYNTHESIS_COMPLETION_GATE",
        "FOLLOWUP_TARGETED", "FOLLOWUP_CLAIM_RETHINK", "CONSISTENCY_GATE",
        "WRITING_DRAFT", "WRITING_FINAL_REVIEW", "WRITING_TARGETED_REVISION", "WRITING_FINAL_APPROVAL",
        "PROPOSAL_STRUCTURING", "PROPOSAL_NOVELTY_REVIEW", "PROPOSAL_PLAN_RECONSTRUCTION",
        "PROPOSAL_CORRECTNESS_REVIEW", "PROPOSAL_REVIEW_GATE", "PROPOSAL_WAITING_DECISIONS",
        "PROPOSAL_REVISION", "PROPOSAL_FINAL_APPROVAL",
        "DONE", "BLOCKED", "PAUSED_BY_USER", "CANCELLED_BY_USER"
      ]
    },
    "artifact_ref": {
      "type": "object",
      "required": ["id", "kind", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^(proj|rq|plan|lit|claim|exp|review|decision|proposal)-[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["Project", "ResearchQuestion", "ResearchPlan", "LiteratureEvidence", "ScientificClaim", "Experiment", "Review", "Decision", "ResearchProposal"]},
        "revision": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "metadata": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["reason", "recorded_at"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "recorded_at": {"type": "string", "format": "date-time"},
            "retry_key": {"type": "string", "minLength": 1},
            "recovery_condition": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "orchestrator_version", "project_id", "run_id", "checkpoint_seq", "status", "state",
    "resume_state", "route", "active_plan", "frozen_snapshot", "branch_states", "gate_results",
    "skill_progress", "retry_counters", "pending_action", "last_completed_action", "blocker", "pause", "cancellation",
    "created_at", "updated_at"
  ],
  "properties": {
    "orchestrator_version": {"const": "research-orchestrator/v0.1"},
    "project_id": {"type": "string", "pattern": "^proj-[a-z0-9][a-z0-9-]*$"},
    "workflow_mode": {"enum": ["FULL_RESEARCH", "PROPOSAL_REVIEW"]},
    "proposal_revision_cycles": {"type": "integer", "minimum": 0, "maximum": 3},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "checkpoint_seq": {"type": "integer", "minimum": 0},
    "status": {"enum": ["RUNNING", "BLOCKED", "PAUSED_BY_USER", "CANCELLED_BY_USER", "DONE"]},
    "state": {"$ref": "#/$defs/state"},
    "resume_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/state"}]},
    "route": {"enum": [null, "THEORY", "EXPERIMENT", "MIXED"]},
    "active_plan": {
      "oneOf": [
        {"type": "null"},
        {"allOf": [{"$ref": "#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ResearchPlan"}}}]}
      ]
    },
    "frozen_snapshot": {
      "type": "object",
      "required": ["git_commit", "artifacts"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}}
      },
      "additionalProperties": false
    },
    "branch_states": {
      "type": "object",
      "required": ["theory", "experiment"],
      "properties": {
        "theory": {"enum": ["NOT_SELECTED", "PENDING", "DEVELOP", "VERIFY", "COMPLETED", "FAILED", "WAIVED"]},
        "experiment": {"enum": ["NOT_SELECTED", "PENDING", "PREPARE", "RUN", "ASSESS", "COMPLETED", "FAILED", "WAIVED"]}
      },
      "additionalProperties": false
    },
    "skill_progress": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["track", "verification_profile", "artifact_ref", "required_skills", "completed_skills", "active_skill", "status"],
        "properties": {
          "track": {"enum": ["theory", "experiment"]},
          "verification_profile": {"enum": [null, "ADVERSARIAL", "CORE_FORMAL", "EMPIRICAL"]},
          "artifact_ref": {"$ref": "#/$defs/artifact_ref"},
          "required_skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "completed_skills": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "active_skill": {"type": ["string", "null"]},
          "status": {"enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"]}
        },
        "additionalProperties": false
      }
    },
    "gate_results": {"type": "array", "items": {"$ref": "gate.schema.json"}},
    "retry_counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "pending_action": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["action_id", "input_git_commit", "started_at"],
          "properties": {
            "action_id": {"type": "string", "minLength": 1},
            "input_git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
            "started_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        }
      ]
    },
    "last_completed_action": {"type": ["string", "null"]},
    "blocker": {"$ref": "#/$defs/metadata"},
    "pause": {"$ref": "#/$defs/metadata"},
    "cancellation": {"$ref": "#/$defs/metadata"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
