{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/runtime/v0.1/context.schema.json",
  "title": "Bounded research handler context v0.1",
  "type": "object",
  "required": [
    "bundle_version", "project_id", "run_id", "action_id", "state", "role",
    "preset", "input_git_commit", "artifacts", "direct_dependencies",
    "target_output_ids", "allowed_outputs", "gate_contract", "limits", "bundle_sha256"
  ],
  "properties": {
    "bundle_version": {"const": "research-context/v0.1"},
    "project_id": {"type": "string", "pattern": "^proj-[a-z0-9][a-z0-9-]*$"},
    "run_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "state": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "preset": {"type": "string", "minLength": 1},
    "input_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "revision", "sha256", "content"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "revision": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "direct_dependencies": {"type": "array", "items": {"type": "object"}},
    "target_output_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "allowed_outputs": {
      "type": "object",
      "required": ["artifact_kinds", "artifact_ids", "create_ids", "rules"],
      "properties": {
        "artifact_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "create_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "operations", "fields"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CREATE", "REVISE"]}},
              "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "gate_contract": {"type": ["object", "null"]},
    "limits": {
      "type": "object",
      "required": ["max_artifacts", "max_serialized_bytes"],
      "properties": {
        "max_artifacts": {"type": "integer", "minimum": 1},
        "max_serialized_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
