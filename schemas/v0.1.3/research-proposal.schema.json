{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/v0.1.3/research-proposal.schema.json",
  "title": "ResearchProposal Artifact v0.1.3",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object",
      "required": ["project_id", "proposal_type", "language", "source_document", "current_document", "rubric_source_document", "rubric_document", "section_index", "source_map", "question_refs", "plan_ref", "review_refs", "change_log_refs", "revision_cycle"],
      "properties": {
        "kind": {"const": "ResearchProposal"}, "id": {"type": "string", "pattern": "^proposal-[a-z0-9][a-z0-9-]*$"},
        "status": {"enum": ["IMPORTED", "STRUCTURED", "UNDER_REVIEW", "REVISION_REQUIRED", "READY_FOR_APPROVAL", "APPROVED", "REJECTED"]},
        "proposal_type": {"const": "ACADEMIC_RESEARCH"}, "language": {"type": "string", "minLength": 2},
        "source_document": {"$ref": "common.schema.json#/$defs/resource_ref"}, "current_document": {"$ref": "common.schema.json#/$defs/resource_ref"},
        "rubric_source_document": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/resource_ref"}]},
        "rubric_document": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/resource_ref"}]},
        "section_index": {"type": "array", "items": {"type": "object", "required": ["id", "title", "locator"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "title": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "source_map": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/resource_ref"}]},
        "question_refs": {"type": "array", "items": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ResearchQuestion"}}}]}},
        "plan_ref": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ResearchPlan"}}}]}]},
        "review_refs": {"type": "array", "items": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "Review"}}}]}},
        "change_log_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/resource_ref"}},
        "revision_cycle": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    }
  ],
  "unevaluatedProperties": false
}
