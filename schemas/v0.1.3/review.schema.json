{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/v0.1.3/review.schema.json",
  "title": "Review Artifact v0.1.3",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object", "required": ["project_id", "target", "reviewer", "summary", "assessment", "issues", "recommendation"],
      "properties": {
        "kind": {"const": "Review"}, "id": {"type": "string", "pattern": "^review-[a-z0-9][a-z0-9-]*$"}, "status": {"enum": ["OPEN", "IN_RESOLUTION", "RESOLVED", "WAIVED"]},
        "target": {"type": "object", "required": ["artifact_ref", "git_commit"], "properties": {"artifact_ref": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"required": ["revision"]}]}, "git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"}}, "additionalProperties": false},
        "reviewer": {"type": "object", "required": ["actor", "reviewer_type"], "properties": {"actor": {"$ref": "common.schema.json#/$defs/actor_ref"}, "reviewer_type": {"enum": ["LITERATURE", "METHODOLOGY", "PROPOSAL_CORRECTNESS"]}}, "additionalProperties": false},
        "summary": {"type": "string", "minLength": 1},
        "assessment": {"type": "object", "required": ["scheme", "outcome", "items"], "properties": {"scheme": {"enum": ["NOVELTY", "PROPOSAL_CORRECTNESS"]}, "outcome": {"enum": ["OPEN", "PARTIAL", "KNOWN", "EQUIVALENT_KNOWN", "UNCERTAIN", "PASS", "REVISION_REQUIRED", "INVALID"]}, "items": {"type": "array", "items": {"type": "object", "required": ["subject", "outcome", "evidence_refs"], "properties": {"subject": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}}, "locator": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}, "additionalProperties": false},
        "evidence_resources": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/resource_ref"}},
        "issues": {"type": "array", "items": {"type": "object", "required": ["id", "title", "description", "severity", "status", "evidence_refs", "locator", "suggested_resolution"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "severity": {"enum": ["BLOCKER", "MAJOR", "MINOR", "SUGGESTION"]}, "status": {"enum": ["OPEN", "ACCEPTED", "RESOLVED", "WONT_FIX"]}, "evidence_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}}, "locator": {"type": "string", "minLength": 1}, "suggested_resolution": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "recommendation": {"enum": ["ACCEPT", "MINOR_REVISION", "MAJOR_REVISION", "REJECT"]}, "resolution_summary": {"type": "string", "minLength": 1}
      }
    }
  ],
  "unevaluatedProperties": false
}
