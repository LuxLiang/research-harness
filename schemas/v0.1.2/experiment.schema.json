{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/v0.1.2/experiment.schema.json",
  "title": "Experiment Artifact v0.1.2",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object",
      "required": ["project_id", "hypothesis", "method", "baselines", "datasets", "metrics", "configuration", "interpretation_plan", "runs"],
      "properties": {
        "kind": {"const": "Experiment"},
        "id": {"type": "string", "pattern": "^exp-[a-z0-9][a-z0-9-]*$"},
        "status": {"enum": ["DRAFT", "PLANNED", "READY", "RUNNING", "COMPLETED", "FAILED", "INVALIDATED"]},
        "hypothesis": {
          "type": "object",
          "required": ["claim_ref", "operationalization"],
          "properties": {
            "claim_ref": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ScientificClaim"}}}]},
            "operationalization": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "method": {"type": "string", "minLength": 1},
        "baselines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "configuration"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "configuration": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "uri", "split_definition"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "uri": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "split_definition": {"type": "string", "minLength": 1},
              "license": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "definition", "direction", "aggregation"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "definition": {"type": "string", "minLength": 1},
              "direction": {"enum": ["HIGHER_BETTER", "LOWER_BETTER", "TARGET_VALUE"]},
              "aggregation": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "configuration": {
          "type": "object",
          "required": ["parameters", "environment"],
          "properties": {
            "config_resource": {"$ref": "common.schema.json#/$defs/resource_ref"},
            "parameters": {"type": "object"},
            "environment": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "interpretation_plan": {
          "type": "object",
          "required": ["supported_when", "contradicted_when", "inconclusive_when", "analysis_plan", "seeds", "repetitions", "hyperparameter_budget", "ablations", "statistical_procedure", "exclusions"],
          "properties": {
            "supported_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "contradicted_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "inconclusive_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "analysis_plan": {"type": "string", "minLength": 1},
            "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
            "repetitions": {"type": "integer", "minimum": 1},
            "hyperparameter_budget": {"type": "string", "minLength": 1},
            "ablations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "statistical_procedure": {"type": "string", "minLength": 1},
            "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "protocol_lock": {
          "type": "object",
          "required": ["revision", "sha256", "locked_at"],
          "properties": {
            "revision": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "locked_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        "code_location": {
          "type": "object",
          "required": ["repository", "git_commit", "entrypoint"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
            "entrypoint": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["run_id", "status", "seed", "protocol_revision", "protocol_sha256", "config_hash", "code_commit", "dataset_hashes", "environment", "environment_hash", "started_at", "finished_at", "outputs", "metric_values", "deviations"],
            "properties": {
              "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "status": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED"]},
              "seed": {"type": ["integer", "null"]},
              "protocol_revision": {"type": "integer", "minimum": 1},
              "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "code_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
              "dataset_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
              "environment": {"type": "string", "minLength": 1},
              "environment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "started_at": {"type": "string", "format": "date-time"},
              "finished_at": {"type": ["string", "null"], "format": "date-time"},
              "outputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/resource_ref"}},
              "metric_values": {"type": "object"},
              "deviations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["category", "description"],
                  "properties": {
                    "category": {"enum": ["ENGINEERING", "SCIENTIFIC"]},
                    "description": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              },
              "failure_reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "result": {
          "type": "object",
          "required": ["summary", "aggregate_metrics", "hypothesis_outcome", "limitations"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "aggregate_metrics": {"type": "object"},
            "hypothesis_outcome": {"enum": ["SUPPORTED", "CONTRADICTED", "INCONCLUSIVE"]},
            "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["READY", "RUNNING", "COMPLETED", "FAILED", "INVALIDATED"]}}},
          "then": {
            "required": ["code_location", "protocol_lock"],
            "properties": {
              "datasets": {"minItems": 1},
              "metrics": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "COMPLETED"}}},
          "then": {
            "required": ["result"],
            "properties": {"runs": {"minItems": 1}}
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
