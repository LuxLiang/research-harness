{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/v0.1.2/scientific-claim.schema.json",
  "title": "Scientific Claim Artifact v0.1.2",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object",
      "required": ["project_id", "claim_type", "statement", "assumptions", "dependencies", "evidence", "verification", "paper_locations"],
      "properties": {
        "kind": {"const": "ScientificClaim"},
        "id": {"type": "string", "pattern": "^claim-[a-z0-9][a-z0-9-]*$"},
        "status": {"enum": ["IDEA", "FORMALIZED", "SUPPORTED", "VERIFIED", "IN_PAPER", "FAILED", "INVALIDATED"]},
        "claim_type": {"enum": ["THEOREM", "LEMMA", "PROPOSITION", "CONJECTURE", "HYPOTHESIS", "EMPIRICAL_CLAIM"]},
        "statement": {"type": "string", "minLength": 1},
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "statement"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "statement": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_ref", "relation"],
            "properties": {
              "claim_ref": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ScientificClaim"}}}]},
              "relation": {"enum": ["USES", "GENERALIZES", "SPECIALIZES", "CONTRADICTS"]}
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["relation", "summary"],
            "properties": {
              "relation": {"enum": ["SUPPORTS", "CONTRADICTS", "VERIFIES"]},
              "source_ref": {
                "allOf": [
                  {"$ref": "common.schema.json#/$defs/artifact_ref"},
                  {"properties": {"kind": {"enum": ["LiteratureEvidence", "Experiment", "ScientificClaim", "Review"]}}}
                ]
              },
              "source_resource": {"$ref": "common.schema.json#/$defs/resource_ref"},
              "summary": {"type": "string", "minLength": 1}
            },
            "oneOf": [
              {"required": ["source_ref"], "not": {"required": ["source_resource"]}},
              {"required": ["source_resource"], "not": {"required": ["source_ref"]}}
            ],
            "additionalProperties": false
          }
        },
        "verification": {
          "type": "object",
          "required": ["method", "protocol", "resource_refs", "review_refs", "conclusion"],
          "properties": {
            "method": {"enum": ["NONE", "PROOF", "EXPERIMENT", "REPLICATION", "EXPERT_REVIEW", "MIXED"]},
            "protocol": {"type": "string"},
            "resource_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/resource_ref"}},
            "review_refs": {"type": "array", "items": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "Review"}}}]}},
            "conclusion": {"type": "string"}
          },
          "additionalProperties": false
        },
        "paper_locations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["manuscript_path", "anchor"],
            "properties": {
              "manuscript_path": {"type": "string", "minLength": 1},
              "anchor": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "failure": {
          "type": "object",
          "required": ["reason", "evidence_refs"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}}
          },
          "additionalProperties": false
        },
        "replacement_ref": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ScientificClaim"}}}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["SUPPORTED", "VERIFIED", "IN_PAPER"]}}},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["VERIFIED", "IN_PAPER"]}}},
          "then": {"properties": {"verification": {"properties": {"method": {"not": {"const": "NONE"}}, "protocol": {"minLength": 1}, "conclusion": {"minLength": 1}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "IN_PAPER"}}},
          "then": {"properties": {"paper_locations": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["FAILED", "INVALIDATED"]}}},
          "then": {"required": ["failure"]}
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
