{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/v0.1.1/review.schema.json",
  "title": "Review Artifact v0.1.1",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object",
      "required": ["project_id", "target", "reviewer", "summary", "issues", "recommendation"],
      "properties": {
        "kind": {"const": "Review"},
        "id": {"type": "string", "pattern": "^review-[a-z0-9][a-z0-9-]*$"},
        "status": {"enum": ["OPEN", "IN_RESOLUTION", "RESOLVED", "WAIVED"]},
        "target": {
          "type": "object",
          "required": ["artifact_ref", "git_commit"],
          "properties": {
            "artifact_ref": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"required": ["revision"]}]},
            "git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"}
          },
          "additionalProperties": false
        },
        "reviewer": {
          "type": "object",
          "required": ["actor", "reviewer_type"],
          "properties": {
            "actor": {"$ref": "common.schema.json#/$defs/actor_ref"},
            "reviewer_type": {"enum": ["PEER", "ADVERSARIAL", "THEORY", "METHODOLOGY", "LITERATURE", "REPRODUCIBILITY", "EDITORIAL"]}
          },
          "additionalProperties": false
        },
        "summary": {"type": "string", "minLength": 1},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "description", "severity", "status", "evidence_refs"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "title": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "severity": {"enum": ["BLOCKER", "MAJOR", "MINOR", "SUGGESTION"]},
              "status": {"enum": ["OPEN", "ACCEPTED", "RESOLVED", "WONT_FIX"]},
              "evidence_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}},
              "resolution": {
                "type": "object",
                "required": ["note", "resolved_in_revision"],
                "properties": {
                  "note": {"type": "string", "minLength": 1},
                  "resolved_in_revision": {"type": ["integer", "null"], "minimum": 1},
                  "decision_ref": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "Decision"}}}]},
                  "resolved_by": {"$ref": "common.schema.json#/$defs/actor_ref"},
                  "resolved_at": {"type": "string", "format": "date-time"}
                },
                "additionalProperties": false
              }
            },
            "allOf": [
              {
                "if": {"properties": {"status": {"enum": ["RESOLVED", "WONT_FIX"]}}},
                "then": {"required": ["resolution"]}
              }
            ],
            "additionalProperties": false
          }
        },
        "recommendation": {"enum": ["ACCEPT", "MINOR_REVISION", "MAJOR_REVISION", "REJECT"]},
        "resolution_summary": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"status": {"enum": ["RESOLVED", "WAIVED"]}}},
      "then": {"required": ["resolution_summary"]}
    }
  ],
  "unevaluatedProperties": false
}
