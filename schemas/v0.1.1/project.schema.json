{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/v0.1.1/project.schema.json",
  "title": "Project Artifact v0.1.1",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object",
      "required": ["name", "slug", "objective", "stage", "owners", "research_questions", "active_plan", "deliverables", "metadata"],
      "properties": {
        "kind": {"const": "Project"},
        "id": {"type": "string", "pattern": "^proj-[a-z0-9][a-z0-9-]*$"},
        "status": {"enum": ["ACTIVE", "BLOCKED", "PAUSED", "COMPLETED", "ARCHIVED"]},
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "objective": {"type": "string", "minLength": 1},
        "stage": {"enum": ["QUESTION", "LITERATURE", "PLANNING", "THEORY_EXPERIMENT", "REVIEW", "WRITING", "COMPLETE"]},
        "owners": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/actor_ref"}},
        "research_questions": {
          "type": "array",
          "items": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ResearchQuestion"}}}]}
        },
        "active_plan": {
          "oneOf": [
            {"type": "null"},
            {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ResearchPlan"}}}]}
          ]
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path", "status"],
            "properties": {
              "kind": {"enum": ["manuscript", "report", "grant_proposal"]},
              "path": {"type": "string", "minLength": 1},
              "status": {"enum": ["PLANNED", "DRAFT", "UNDER_REVIEW", "FINAL"]}
            },
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "object",
          "required": ["domains", "keywords", "started_on", "target_venues", "confidentiality"],
          "properties": {
            "domains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "started_on": {"type": "string", "format": "date"},
            "target_venues": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "confidentiality": {"enum": ["PRIVATE", "INTERNAL", "PUBLIC"]},
            "license": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "not": {"required": ["project_id"]}
    }
  ],
  "unevaluatedProperties": false
}
