{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-harness.local/schemas/v0.1.1/research-question.schema.json",
  "title": "Research Question Artifact v0.1.1",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {
      "type": "object",
      "required": ["project_id", "problem_definition", "background", "scope", "known_results", "research_gap", "hypotheses", "expected_contributions", "risks"],
      "properties": {
        "kind": {"const": "ResearchQuestion"},
        "id": {"type": "string", "pattern": "^rq-[a-z0-9][a-z0-9-]*$"},
        "status": {"enum": ["DRAFT", "ACTIVE", "ANSWERED", "REFRAMED", "CLOSED"]},
        "problem_definition": {"type": "string", "minLength": 1},
        "background": {"type": "string", "minLength": 1},
        "scope": {
          "type": "object",
          "required": ["included", "excluded"],
          "properties": {
            "included": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "known_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "evidence_refs"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "evidence_refs": {
                "type": "array",
                "items": {
                  "allOf": [
                    {"$ref": "common.schema.json#/$defs/artifact_ref"},
                    {"properties": {"kind": {"enum": ["LiteratureEvidence", "ScientificClaim"]}}}
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "research_gap": {"type": "string", "minLength": 1},
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["statement"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "claim_ref": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ScientificClaim"}}}]}
            },
            "additionalProperties": false
          }
        },
        "expected_contributions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "description", "likelihood", "impact", "mitigation"],
            "properties": {
              "category": {"enum": ["NOVELTY", "THEORY", "DATA", "COMPUTE", "ETHICS", "SCHEDULE"]},
              "description": {"type": "string", "minLength": 1},
              "likelihood": {"enum": ["LOW", "MEDIUM", "HIGH"]},
              "impact": {"enum": ["LOW", "MEDIUM", "HIGH"]},
              "mitigation": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "replacement_ref": {"allOf": [{"$ref": "common.schema.json#/$defs/artifact_ref"}, {"properties": {"kind": {"const": "ResearchQuestion"}}}]}
      },
      "if": {"properties": {"status": {"const": "REFRAMED"}}},
      "then": {"required": ["replacement_ref"]}
    }
  ],
  "unevaluatedProperties": false
}
