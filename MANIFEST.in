include README.md VERSION AGENTS.md CONTRIBUTING.md LICENSE
recursive-include schemas *.json *.md
recursive-include config *.yaml
recursive-include evals *.yaml *.json *.md
recursive-include integrations/deepseek-harness/skills *.yaml *.json *.md
recursive-include integrations/deepseek-harness/presets *.yaml *.yml *.json *.md
